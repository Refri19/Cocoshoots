generator client {
  provider = "prisma-client" // Note: "prisma-client" is the new v7 provider
  output   = "../src/generated/prisma" // Specify a custom output path
}

datasource db {
  provider = "sqlite"
}
model blog {
  id        Int    @id @default(autoincrement())
  title     String
  excerpt   String
  date      String
  createdAt String
}
model feedback {
  id        Int    @id @default(autoincrement())
  name      String
  category  String
  message   String
  createdAt String
}
model user {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String
  password  String
  createdAt DateTime @default(now())
}
model photo {
  id       Int     @id @default(autoincrement())
  name     String?
  filename String?
  img      Bytes?
}
model venue {
  id          Int    @id @default(autoincrement())
  name        String
  email       String @unique
  phonenumber String
  location    String
  scheduledat String
}
