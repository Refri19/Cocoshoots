generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model blog {
  id          Int    @id @default(autoincrement())
  blogimage   Bytes?
  category    String
  title       String
  excerpt     String
  morecontent String
  createdAt   String
}

model feedback {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  category  Category
  message   String
  createdAt DateTime @default(now())
}

enum Category {
  suggestion
  bug
  praise
  other
}

model user {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String
  password  String
  createdAt DateTime @default(now())
}

model facebookpost {
  id        Int      @id @default(autoincrement())
  url       String
  createdAt DateTime @default(now())
}

model Venue {
  id          String   @id @default(cuid())
  name        String
  email       String
  phonenumber String
  reasoning   String
  scheduleAt  DateTime
  createdAt   DateTime @default(now())
}
